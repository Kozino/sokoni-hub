+/* Admin: offers and coupons. Scoped under .of-page / .of-form so nothing else on the site is affected. */
+
+.of-page .of-funding {
+  margin: var(--s-4) 0;
+  padding: var(--s-3) var(--s-4);
+  background: var(--success-soft);
+  border: 1px solid var(--success-line);
+  color: var(--success-text);
+  border-radius: var(--r-lg);
+  font-size: var(--fs-sm);
+  line-height: 1.55;
+}
+
+.of-list { display: flex; flex-direction: column; gap: var(--s-3); }
+
+.of-card {
+  --of-accent: var(--accent);
+  display: grid;
+  grid-template-columns: minmax(200px, 1.7fr) minmax(150px, 1.2fr) minmax(140px, 1fr) minmax(150px, 1fr) 96px;
+  grid-template-areas:
+    'main rules runs used status'
+    'actions actions actions actions actions';
+  gap: var(--s-3) var(--s-4);
+  align-items: start;
+  padding: var(--s-4) var(--s-5);
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-left: 4px solid var(--of-accent);
+  border-radius: var(--r-lg);
+}
+.of-card > * { min-width: 0; }
+.of-main { grid-area: main; }
+.of-rules { grid-area: rules; }
+.of-runs { grid-area: runs; }
+.of-used { grid-area: used; }
+.of-status { grid-area: status; }
+.of-actions { grid-area: actions; display: flex; flex-wrap: wrap; gap: var(--s-2); justify-content: flex-end; padding-top: var(--s-3); border-top: 1px solid var(--border-subtle); }
+.of-rules, .of-runs, .of-used, .of-status { display: flex; flex-direction: column; gap: 2px; font-size: var(--fs-sm); }
+.of-actions .btn { white-space: nowrap; }
+
+.of-title { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2); }
+.of-title strong { font-size: var(--fs-md, 1rem); }
+.of-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--of-accent); flex: none; }
+.of-code {
+  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+  font-size: var(--fs-xs); font-weight: 700; letter-spacing: .06em;
+  padding: 2px 8px; border-radius: var(--r-sm, 6px);
+  background: var(--surface-3); color: var(--text); border: 1px dashed var(--border-strong);
+}
+.of-gives { margin-top: var(--s-1); font-weight: 650; color: var(--of-accent); }
+
+.of-bar { display: block; height: 6px; border-radius: 999px; background: var(--surface-3); overflow: hidden; margin-top: 4px; max-width: 150px; }
+.of-bar i { display: block; height: 100%; background: var(--of-accent); border-radius: 999px; }
+
+.of-h2 { font-size: var(--fs-md, 1rem); margin: 0 0 var(--s-2); }
+.of-history { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg); padding: var(--s-4) var(--s-5); }
+.of-hrow { display: flex; justify-content: space-between; gap: var(--s-4); padding: var(--s-2) 0; border-top: 1px solid var(--border-subtle); }
+.of-hrow:first-of-type { border-top: 0; }
+
+@media (max-width: 960px) {
+  .of-card {
+    grid-template-columns: 1fr 1fr;
+    grid-template-areas: 'main main' 'rules runs' 'used status' 'actions actions';
+  }
+  .of-actions { justify-content: flex-start; }
+}
+@media (max-width: 560px) {
+  .of-card { grid-template-columns: 1fr; grid-template-areas: 'main' 'rules' 'runs' 'used' 'status' 'actions'; padding: var(--s-4); }
+}
+
+/* ---- the create / edit form */
+.modal.modal-wide { max-width: 760px; }
+.of-form .of-h3 { font-size: var(--fs-sm); text-transform: uppercase; letter-spacing: .05em; color: var(--text-muted); margin: var(--s-5) 0 var(--s-3); padding-top: var(--s-4); border-top: 1px solid var(--border-subtle); }
+.of-form .of-two > .field { flex: 1; min-width: 0; }
+.of-form .of-three > .field { flex: 1; min-width: 0; }
+.of-form .of-two, .of-form .of-three { align-items: flex-start; }
+@media (max-width: 640px) { .of-form .of-two, .of-form .of-three { flex-direction: column; align-items: stretch; } }
+
+.of-preview {
+  --of-accent: var(--accent);
+  position: relative; overflow: hidden;
+  display: grid; gap: 2px;
+  padding: var(--s-4) var(--s-5);
+  border-radius: var(--r-lg);
+  color: #fff;
+  background: linear-gradient(135deg, var(--of-accent), color-mix(in srgb, var(--of-accent) 70%, #000));
+}
+.of-preview::after { content: ''; position: absolute; right: -30px; top: -40px; width: 130px; height: 130px; border-radius: 50%; background: rgba(255,255,255,.12); }
+.of-pv-badge { font-size: 10px; font-weight: 800; letter-spacing: .12em; opacity: .85; }
+.of-pv-title { font-size: 1.05rem; font-weight: 750; letter-spacing: -.01em; }
+.of-pv-sub { font-size: var(--fs-sm); opacity: .92; }
+.of-pv-cta { justify-self: start; margin-top: var(--s-2); padding: 3px 12px; border-radius: 999px; background: rgba(255,255,255,.2); border: 1px dashed rgba(255,255,255,.7); font-weight: 700; font-size: var(--fs-xs); letter-spacing: .06em; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
+.of-sentence { margin: var(--s-3) 0 0; padding: var(--s-3) var(--s-4); background: var(--surface-2); border-radius: var(--r-md, 8px); font-size: var(--fs-sm); color: var(--text-2); line-height: 1.55; }
+
+.of-seg { display: inline-flex; border: 1px solid var(--border-strong); border-radius: 999px; padding: 3px; gap: 2px; margin-bottom: var(--s-4); background: var(--surface-2); flex-wrap: wrap; }
+.of-seg button { border: 0; background: transparent; padding: 6px 14px; border-radius: 999px; font: inherit; font-size: var(--fs-sm); font-weight: 600; color: var(--text-2); cursor: pointer; }
+.of-seg button.is-on { background: var(--accent); color: var(--text-invert); }
+.of-seg button:disabled { opacity: .55; cursor: not-allowed; }
+
+.of-check { margin: var(--s-2) 0 var(--s-3); font-size: var(--fs-sm); }
+.of-check small { color: var(--text-muted); }
+/* the site-wide input rule is width:100%, which would push the box away from its label */
+.of-check input[type='checkbox'] { width: auto; flex: none; }
+
+.of-swatches { display: flex; gap: var(--s-2); flex-wrap: wrap; }
+.of-swatches button { width: 30px; height: 30px; border-radius: 50%; border: 3px solid var(--surface); box-shadow: 0 0 0 1px var(--border-strong); cursor: pointer; }
+.of-swatches button.is-on { box-shadow: 0 0 0 2px var(--text); }
+
+.of-table { display: flex; flex-direction: column; }
+.of-trow { display: grid; grid-template-columns: 1.1fr 1.2fr 1.2fr .8fr 1.2fr; gap: var(--s-3); padding: var(--s-2) 0; border-top: 1px solid var(--border-subtle); font-size: var(--fs-sm); align-items: center; }
+.of-trow > * { min-width: 0; overflow-wrap: anywhere; }
+.of-thead { border-top: 0; font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: .04em; font-weight: 700; color: var(--text-muted); }
+@media (max-width: 640px) { .of-trow { grid-template-columns: 1fr 1fr; } .of-thead { display: none; } }
