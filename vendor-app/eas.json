{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.sokonihub.qa",
        "EXPO_PUBLIC_WEB_URL": "https://sokonihub.qa"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.sokonihub.qa",
        "EXPO_PUBLIC_WEB_URL": "https://sokonihub.qa"
      }
    },
    "simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.sokonihub.qa",
        "EXPO_PUBLIC_WEB_URL": "https://sokonihub.qa"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "distribution": "store",
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "app-bundle",
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.sokonihub.qa",
        "EXPO_PUBLIC_WEB_URL": "https://sokonihub.qa"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "companyName": "Sokoni Hub"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
