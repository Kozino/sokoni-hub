{
  "expo": {
    "name": "Sokoni Hub",
    "slug": "sokoni-hub",
    "scheme": "sokonihub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "qa.sokonihub.consumer",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        },
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Allow Sokoni Hub to use Face ID to authenticate you securely and quickly."
      }
    },
    "android": {
      "package": "qa.sokonihub.consumer",
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_ANDROID_MAPS_KEY"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#F6F4EE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-local-authentication",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true
          }
        }
      ],
      "expo-secure-store",
      "expo-image",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#F8F8FD",
          "dark": {
            "image": "./assets/splash.png",
            "backgroundColor": "#101815"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sokoni Hub uses your location to confirm where your order should be delivered and to show your rider on the map."
        }
      ]
    ]
  }
}
