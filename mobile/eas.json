{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://sokoni-hub.onrender.com",
        "EXPO_PUBLIC_WEB_URL": "https://sokoni-hub.netlify.app"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://sokoni-hub.onrender.com",
        "EXPO_PUBLIC_WEB_URL": "https://sokoni-hub.netlify.app"
      }
    },
    "simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://sokoni-hub.onrender.com",
        "EXPO_PUBLIC_WEB_URL": "https://sokoni-hub.netlify.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://sokoni-hub.onrender.com",
        "EXPO_PUBLIC_WEB_URL": "https://sokoni-hub.netlify.app"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
