{
  "compilerOptions": {
    "target": "ES2021",
    // "node16" works on TypeScript 5 AND 7. The old "commonjs"/"node" pair maps to
    // moduleResolution "node10", which TypeScript 7 removed (error TS5108).
    // This still emits CommonJS, which is what `node dist/server.js` expects.
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2021"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"]
}
