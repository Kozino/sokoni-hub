# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,https://your-site.netlify.app

# --- Database (Supabase -> Project Settings -> Database -> Connection string -> URI) ---
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
PGSSL=true

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d

# --- Supabase Storage (for listing images / KYC docs) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_BUCKET=listings

# --- Platform ---
DEFAULT_CURRENCY=QAR
PLATFORM_WHATSAPP=2348000000000

# --- Email (optional; default is 'none' = no email is ever sent) ---
# Provider is either resend or brevo. All three of PROVIDER, API_KEY and FROM
# must be set before any mail goes out; if any is missing, sends are recorded
# in email_log with status 'skipped' and nothing breaks.
EMAIL_PROVIDER=none
EMAIL_API_KEY=
EMAIL_FROM=billing@yourdomain.com
EMAIL_FROM_NAME=Sokoni Hub
EMAIL_REPLY_TO=support@yourdomain.com

# --- Scheduled billing run ---
# Long random string. Protects POST /api/billing/cron/run, which is called by an
# external scheduler rather than by a logged-in user. Without it that route 503s.
CRON_SECRET=
