# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,https://your-site.netlify.app

# --- Database (Supabase -> Project Settings -> Database -> Connection string -> URI) ---
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
PGSSL=true

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d

# --- Supabase Storage (for listing images / KYC docs) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_BUCKET=listings

# --- Platform ---
DEFAULT_CURRENCY=USD
PLATFORM_WHATSAPP=2348000000000
