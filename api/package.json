{
  "name": "sokoni-api",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed:admin": "tsx src/scripts/createAdmin.ts",
    "render-build": "npm ci --include=dev && tsc -p tsconfig.json",
    "migrate:prod": "node dist/scripts/migrate.js",
    "seed:admin:prod": "node dist/scripts/createAdmin.js",
    "admin:mfa": "tsx src/scripts/enrollAdminMfa.ts",
    "admin:mfa:prod": "node dist/scripts/enrollAdminMfa.js",
    "documents:migrate": "tsx src/scripts/migrateDocuments.ts",
    "documents:migrate:prod": "node dist/scripts/migrateDocuments.js",
    "test:security": "node ../tests/security.mjs",
    "test:bookings": "node ../tests/run-bookings.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "otpauth": "^9.5.2",
    "pg": "^8.12.0",
    "sharp": "^0.35.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "tsx": "~4.19.1",
    "typescript": "~7.0.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
